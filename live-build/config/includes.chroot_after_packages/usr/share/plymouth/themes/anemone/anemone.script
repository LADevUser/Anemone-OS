# Anemone OS — Plymouth boot theme
# Bakgrunden är papperets gulnade ton — #FAF6EC (250, 246, 236).
# Illustrationen tonar in som en kapitelplansch.

Window.SetBackgroundTopColor(0.980, 0.965, 0.925);
Window.SetBackgroundBottomColor(0.980, 0.965, 0.925);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo = Image("logo.png");

# Bilden är fast 1920x1080 — skala ner på mindre upplösningar (t.ex.
# 1366x768) så den inte klipps av skärmkanten.
if (logo.GetWidth() > screen_width || logo.GetHeight() > screen_height) {
    scale = Math.Min(screen_width / logo.GetWidth(), screen_height / logo.GetHeight());
    logo = logo.Scale(logo.GetWidth() * scale, logo.GetHeight() * scale);
}

sprite = Sprite(logo);

sprite.SetX((screen_width - logo.GetWidth()) / 2);
sprite.SetY((screen_height - logo.GetHeight()) / 2);
sprite.SetOpacity(0);

logo_opacity = 0;

fun refresh_callback() {
    if (logo_opacity < 1) {
        logo_opacity = logo_opacity + 0.02;
        if (logo_opacity > 1) {
            logo_opacity = 1;
        }
        sprite.SetOpacity(logo_opacity);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
